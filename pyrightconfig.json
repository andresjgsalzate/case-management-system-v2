{
  "include": ["backend"],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/.next",
    "backend/alembic/versions"
  ],
  "extraPaths": ["."],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["."]
    }
  ],
  "pythonVersion": "3.13",
  "reportMissingImports": "warning",
  "reportUnusedParameter": "none",
  "reportUnusedFunction": "none",
  "typeCheckingMode": "basic"
}
