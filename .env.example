# ─────────────────────────────────────────────────────────────
#  CMS root .env — template
#  Copy to .env (gitignored) and fill in secrets before
#  `docker compose up`. NEVER commit the populated .env.
#
#  Generate cryptographic secrets with:
#    openssl rand -base64 32         (32-byte base64 — for OAUTH2_PROXY_COOKIE_SECRET)
#    openssl rand -hex 32            (64-char hex   — for client secrets)
# ─────────────────────────────────────────────────────────────

# ─── Keycloak (sub-spec 09) ──────────────────────────────────
# Used by the `keycloak` container on first boot. Re-importing the realm
# requires wiping the keycloak_data volume — see docs/INFRA.md.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-boot

# Client secret for the `oauth2-proxy` confidential client, declared in
# keycloak/realm-export.json. MUST match the `secret` field of the
# `oauth2-proxy` client in that file — rotate both together.
# (Generate with: openssl rand -hex 32)
OAUTH2_PROXY_CLIENT_SECRET=dev-oauth2-proxy-secret-rotate-with-env-var

# Symmetric secret used by oauth2-proxy to sign its session cookie.
# Must be 16, 24, or 32 raw bytes; base64-encoded values are accepted.
# Generate with:  openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=change-me-generate-with-openssl-rand-base64-32
