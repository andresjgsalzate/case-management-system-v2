{
  "realm": "cms",
  "displayName": "Case Management System",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,

  "_comment_session": "Token lifespans tuned for dev. Production should shorten access token TTL (e.g. 5 min) and rely on refresh.",
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,

  "roles": {
    "_comment": "Realm roles mirror the CMS role hierarchy; CMS resolves the highest matching role via realm_access.roles in the JWT.",
    "realm": [
      { "name": "super_admin", "description": "Global access to all tenants and admin operations" },
      { "name": "admin",       "description": "Tenant-scoped administrator" },
      { "name": "manager",     "description": "Manage cases, runbooks, users within tenant" },
      { "name": "agent",       "description": "Frontline SOC analyst — case work" },
      { "name": "reporter",    "description": "Read-only access" }
    ]
  },

  "clientScopes": [
    {
      "name": "tenant-id",
      "description": "Adds tenant_id user attribute as a JWT claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "tenant-id"
  ],

  "clients": [
    {
      "_comment": "Public client for the Next.js frontend. Authorization Code + PKCE only.",
      "clientId": "cms-frontend",
      "name": "CMS Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://cms.local/auth/callback",
        "https://cms.local/*"
      ],
      "webOrigins": [
        "https://cms.local"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://cms.local/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "tenant-id"
      ]
    },
    {
      "_comment": "Confidential client reserved for backend → Keycloak admin API calls (user provisioning). Optional v1; secret can be rotated via UI.",
      "clientId": "cms-backend",
      "name": "CMS Backend (service)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-cms-backend-secret-replace-on-deploy",
      "attributes": {
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "_comment": "Confidential client used by oauth2-proxy in front of n8n. The 'secret' below MUST match OAUTH2_PROXY_CLIENT_SECRET in the .env consumed by docker-compose. Rotate together.",
      "clientId": "oauth2-proxy",
      "name": "n8n Front Proxy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "dev-oauth2-proxy-secret-rotate-with-env-var",
      "redirectUris": [
        "https://cms.local/n8n/oauth2/callback"
      ],
      "webOrigins": [
        "https://cms.local"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://cms.local/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "tenant-id"
      ]
    }
  ],

  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
